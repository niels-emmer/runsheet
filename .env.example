# Copy to .env and fill in. .env is gitignored; this file is not.
# Everything here points an agent at ONE station. No values are committed.
#
# One shared file instead of a .env per checkout: RUNSHEET_ENV_FILE is not a
# variable in this file, it is read from the REAL environment. Set it to the
# path of a credentials file outside every checkout and runsheet loads the
# SUBWAVE_* values from there, without reading ./.env at all. Any ephemeral git
# worktree then needs no .env of its own. Precedence: exported variables beat
# the named file, which replaces ./.env rather than merging with it; a path
# that is set but missing is an error (exit 2).

# Base URL of the station's admin API, e.g. http://127.0.0.1:7700 (a tunnel is fine).
SUBWAVE_BASE_URL=

# Admin HTTP Basic user.
SUBWAVE_ADMIN_USER=

# Admin HTTP Basic password.
SUBWAVE_ADMIN_PASS=

# Station password that gates listeners (settings.privacy.password on the station).
SUBWAVE_STATION_PASSWORD=

# Tier 2 only, optional: ssh host for full-fidelity reads (shows, schedule, backups).
# Set this and run `status`: it finds the container and the data directory, and
# prints the two lines below for you.
SUBWAVE_HOST=

# Tier 2 only, optional: state dir on that host, usually /var/sub-wave inside the controller.
SUBWAVE_STATE_DIR=

# Tier 2 only, optional: the controller container's name, used for `docker exec`
# reads of the state dir. Defaults to the image default, sub-wave-controller;
# set it if your install renamed the container.
SUBWAVE_CONTAINER=

# Not a variable in this file: ANTHROPIC_API_KEY is read from the real
# environment only, never from .env (it is not a SUBWAVE_* key, so the loader
# does not pick it up). `apply` uses it to rehydrate a redacted llm.apiKey —
# export it in your shell if your station is configured with an LLM.
